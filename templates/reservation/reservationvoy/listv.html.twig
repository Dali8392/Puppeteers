{% extends 'baseAdmin.html.twig' %}

{% block title %}List of Travel Reservations{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .first-row {
            background-color: #6495ED;
            color: black; /* Change text color if needed */
        }
        .custom-table-container {
            max-width: 800px; /* Set desired maximum width */
            margin: 0 auto; /* Center the container */
        }
        .text-center {
            text-align: center; /* Center-align text */
        }
    </style>
{% endblock %}

{% block body %}
<br>
<br>
<br>
<h1 class="text-center">List of Travel Reservations</h1>
<br>
<br>

<div class="custom-table-container">
    <div class="table-responsive">
        <table class="table mx-auto">
            <thead>
                <tr class="first-row">
                    <th>ID</th>
                    <th>Date</th>
                    <th>Number of Passengers</th>
                    <th>User ID</th>
                    <th class="paiement-id">Payment ID</th>
                    <th class="voyage-id">Voyage ID</th>
                    <th>Action</th> 
                </tr>
            </thead>
            <tbody>
                {% for reservation in reservations %}
                <tr>
                    <td>{{ reservation.id }}</td>
                     <td>{{ reservation.date|date('Y-m-d') }}</td>
                    <td>{{ reservation.max }}</td>
                    <td>{{ reservation.idUser }}</td>
                    <td class="paiement-id">{{ reservation.paiement ? reservation.paiement.id : '' }}</td>
                    <td class="voyage-id">{{ reservation.voyage ? reservation.voyage.id : '' }}</td>
                    <td>
                        <form method="POST" action="{{ path('delete_reservation_voy', {'id': reservation.id}) }}" onsubmit="return confirm('Are you sure you want to delete this reservation?')">
                            <button type="submit" class="btn btn-danger">Delete</button>
                        </form>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}



