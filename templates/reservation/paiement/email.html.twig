<!DOCTYPE html>
<html>
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    <title>Payment Confirmation</title>
    <style>
        body {
            margin: 0;
            padding: 0;
            text-align: center;
            font-family: 'Verdana Regular', 'Verdana', 'sans-serif';
            font-size: 12px;
        }

        .container {
            width: 100%;
            max-width: 600px;
            margin: 0 auto;
            border: 1px solid gainsboro;
            text-align: left;
        }

        .content {
            padding: 20px;
        }

        .content h2 {
            color: #8a2be2; /* Violet */
        }

        .content ul {
            padding-left: 20px;
        }

        .footer {
            padding: 10px;
            background-color: #f0f0f0;
        }

       .bold {
            font-weight: bold;
            padding: 10px;
            background-color: rgba(138, 43, 226, 0.1); /* Violet avec une opacité de 10% */
            border: 1px solid rgba(138, 43, 226, 0.5); /* Bordure violette avec une opacité de 50% */
            border-radius: 5px; /* Coins arrondis */
        }
    </style>
</head>
<body>
<table cellspacing="0" cellpadding="0" class="container">
    <tr>
        <td>
            <div class="content">
                <table cellspacing="0" cellpadding="0" align="center" style="width:600px; height:80px;">
                    <tr>
                        <td style="text-align:left; width:300px; height:80px;">
                            <div style="font-size: 24px; font-weight: bold; color: #8a2be2;">Welcome</div>
                        </td>
                        <td style="text-align:left; width:200px; font-family:'Verdana Regular','Verdana','sans-serif'; font-size:12px;">
                            <div style="font-size:16px; font-weight:bold; color:#8a2be2;margin-right:5px">Payment Confirmation</div>
                            <div>HawesBiya Travel Agency<br/>{{ paiement.date|date }}</div>
                        </td>
                    </tr>
                </table>
                <p>Hello,</p>
                <p>Your transaction has been accepted and recorded.</p>
                <p>Here are the payment details :</p>
                <ul>
                    <li>Invoice Number : {{ paiement.id}} </li>
                    <li>Amount : {{ paiement.montant }} €</li>
                    <li>Method : {{ paiement.methode}} </li>
                </ul>
                <p class="bold">Enjoy your stay and have a safe journey! Thank you for your trust!</p>
               
                <p>Address: Cite el ghazela ariana Tunisia 2083 <br> Phone: +216 71 969 969 <br> Email: hawesBiya@gmail.com</p>
                
            </div>
        </td>
    </tr>
    <tr>
        <td class="footer">
            <p>© 2024 puppeteers. cite el ghazela ariana, Tunisia</p>
        </td>
    </tr>
</table>
</body>
</html>
