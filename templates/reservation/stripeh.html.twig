{% extends 'base.html.twig' %}
{% block title %}Stripe Payment Gateway{% endblock %}
{% block body %}
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Stripe Payment Gateway</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
    <style>
        /* Ajouter du style CSS personnalisé ici */
        .stripe-bg {
            background-image: url('{{ asset('images/home_slider.jpg') }}');
            background-position: center;
            background-size: cover;
            background-repeat: no-repeat;
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
        }
        .stripe-form-container {
            max-width: 400px;
            padding: 20px;
            background-color: rgba(0, 0, 0, 0.7); /* Fond noir transparent */
            border-radius: 10px;
        }
        .stripe-form {
            color: white; /* Couleur du texte blanc pour une meilleure lisibilité */
        }
        .amount-label {
            color: black; /* Couleur du texte en noir */
            font-weight: bold; /* Texte en gras pour la mise en évidence */
        }
        #pay-btn {
            background-color: purple; /* Couleur violette pour le bouton */
            border: none;
        }
        #pay-btn:hover {
            background-color: darkviolet; /* Couleur violette foncée au survol */
        }
    </style>
</head>
<body>
    <div class="stripe-bg">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-12 text-center stripe-form-container">
                    <div class="card stripe-form">
                        <div class="card-body">
                            {% for message in app.flashes('success') %}
                                <div style="color: violet; border: 2px violet solid; text-align: center; padding: 5px; margin-bottom: 10px;">
                                    {{ message }}
                                </div>
                            {% endfor %}
          
                            <form id='checkout-form' method='post' action="{{ path('app_stripe_charge') }}">             
                                <input type='hidden' name='stripeToken' id='stripe-token-id'>   
                                <input type='hidden' name='reservation_id' value='{{ reservation.id }}'>  
                                <input type='hidden' name='amount' value='{{ reservation.hebergement.tarif }}'>                         
                                <div class="mb-3 amount-label">Amount to Pay: ${{ reservation.hebergement.tarif }}</div>
                                <div id="card-element"></div>
                                <button id='pay-btn' class="btn btn-success mt-3" type="button" style="width: 100%; padding: 7px;" onclick="createToken()">Pay</button> 
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <script src="https://js.stripe.com/v3/"></script>
    <script>
        var stripe = Stripe("{{stripe_key}}");
        var elements = stripe.elements();
        var cardElement = elements.create('card');
        cardElement.mount('#card-element');
     
        function createToken() {
            document.getElementById("pay-btn").disabled = true;
            stripe.createToken(cardElement).then(function(result) {               
                if (result.error) {
                    document.getElementById("pay-btn").disabled = false;
                    alert(result.error.message);
                }
     
                if (result.token) {
                    document.getElementById("stripe-token-id").value = result.token.id;
                    document.getElementById('checkout-form').submit();
                }
            });
        }
    </script>
</body>
</html>
{% endblock %}
