{% extends 'base.html.twig' %}

{% block title %}Subscriptions{% endblock %}


{% block body %}
<div class="container" style="margin-top: 200px;">

<h1>Subscribed Activities</h1>

{% if subscribedActivities is empty %}
    <p>No activities subscribed yet.</p>
{% else %}
    <table class="table">
        <thead>
            <tr>
                <th>ID</th>
                <th>City</th>
                <th>Price</th>
                <th>Details</th>
                <th>Time</th>
            </tr>
        </thead>
        <tbody>
            {% for activite in subscribedActivities %}
                <tr>
                    <td>{{ activite.id }}</td>
                    <td>{{ activite.ville }}</td>
                    <td>{{ activite.prix }}</td>
                    <td>{{ activite.details }}</td>
                    <td>{{ activite.heure }}</td>
                
                </tr>
            {% endfor %}
        </tbody>
    </table>
    </div>
{% endif %}
{% endblock %}