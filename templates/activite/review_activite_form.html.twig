{% extends 'baseAdmin.html.twig' %}

{% block title %}Activite index{% endblock %}

{% block body %}
<style>
    .grid-container {
        display: grid;
        grid-template-columns: repeat(3, 1fr); 
        grid-gap: 10px;
    }

    .grid-item {
        border: 1px solid #ccc;
        padding: 10px;
        margin-bottom: 10px;
        display: flex;
        flex-direction: column; 
        align-items: center; 
        justify-content: flex-end; 
    }

    .grid-item a {
        display: inline-block; 
        margin: 5px; 
        
    }

    .button-accept {
        background-color: green;
        color: white; 
        padding: 5px 10px;
        border: none;
        border-radius: 5px;
        cursor: pointer;
    }

    .button-delete {
        background-color: red;
        color: white; 
        padding: 5px 10px;
        border: none;
        border-radius: 5px;
        cursor: pointer;
    }

    @media (min-width: 768px) {
        .grid-item {
            align-items: flex-start; 
            justify-content: space-between;
        }
    }
</style>

<div class="container" style="margin-top: 200px;">
    <h1>Pending activités</h1>

    <div class="grid-container">
        {% for activite in activites %}
            {% if activite.etat == 0 %}
                <div class="grid-item">
                    <a href="{{ path('app_activite_show', {'id': activite.id}) }}">
                        <h3>{{ activite.ville }}</h3>
                        <p>Prix: {{ activite.prix }}</p>
                        <p>Heure: {{ activite.heure }}</p>
                    </a>

                    <a href="{{ path('app_activite_valider', {'id': activite.id}) }}" class="button-accept">Accept</a>
                    <a href="{{ path('app_activite_delete', {'id': activite.id}) }}" class="button-delete">Delete</a>

                    
                </div>
            {% endif %}
        {% endfor %}
    </div>

</div>
{% endblock %}