{% extends 'base.html.twig' %}

{% block title %}Activite index{% endblock %}

{% block body %}
<style>
    .grid-container {
        display: grid;
        grid-template-columns: repeat(3, 1fr); /* Adjust columns as needed */
        grid-gap: 10px;
    }

    .grid-item {
        border: 1px solid #ccc;
        padding: 10px;
        margin-bottom: 10px;
        display: flex;
        flex-direction: column; /* Stack elements vertically */
        align-items: center; /* Center horizontally */
        justify-content: flex-end; /* Align buttons at bottom */
    }

    .grid-item a {
        display: inline-block; /* Allow buttons to shrink */
        margin: 5px; /* Add some spacing around buttons */
        /* Remove grey color if needed */
    }

    .button-accept {
        background-color: green;
        color: white; /* Set text color explicitly */
        padding: 5px 10px;
        border: none;
        border-radius: 5px;
        cursor: pointer;
    }

    .button-delete {
        background-color: red;
        color: white; /* Set text color explicitly */
        padding: 5px 10px;
        border: none;
        border-radius: 5px;
        cursor: pointer;
    }

    /* Optional media query for wider screens (adjust as needed) */
    @media (min-width: 768px) {
        .grid-item {
            align-items: flex-start; /* Align buttons at top in wider screens */
            justify-content: space-between; /* Spread buttons horizontally */
        }
    }
</style>

<div class="container" style="margin-top: 200px;">
    <h1>Pending activités</h1>

    <div class="grid-container">
        {% for activite in activites %}
            {% if activite.etat == 0 %}
                <div class="grid-item">
                    <a href="{{ path('app_activite_show', {'id': activite.id}) }}">
                        <h3>{{ activite.ville }}</h3>
                        <p>Prix: {{ activite.prix }}</p>
                        <p>Heure: {{ activite.heure }}</p>
                    </a>

                    <a href="{{ path('app_activite_valider', {'id': activite.id}) }}" class="button-accept">Accept</a>
                    <a href="{{ path('app_activite_delete', {'id': activite.id}) }}" class="button-delete">Delete</a>

                    
                </div>
            {% endif %}
        {% endfor %}
    </div>

    <a href="{{ path('app_activite_index') }}">back to list</a>
</div>
{% endblock %}