{% extends 'baseAdmin.html.twig' %}

{% block title %}Guide{% endblock %}

{% block body %}
 <div class="container" style="margin-top: 200px;">

    <h1>{{ guide.name }}</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ guide.id }}</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>{{ guide.name }}</td>
            </tr>
            <tr>
                <th>LastName</th>
                <td>{{ guide.lastName }}</td>
            </tr>
            <tr>
                <th>Email</th>
                <td>{{ guide.email }}</td>
            </tr>
            <tr>
                <th>Cin</th>
                <td>{{ guide.cin }}</td>
            </tr>
            <tr>
                <th>Role</th>
                <td>{{ guide.role }}</td>
            </tr>
            <tr>
                <th>Langue</th>
                <td>{{ guide.langue }}</td>
            </tr>
            <tr>
                <th>Ville</th>
                <td>{{ guide.ville }}</td>
            </tr>
        </tbody>
    </table>
</div>
    <a href="{{ path('app_guide_index') }}">back to list</a>

    <a href="{{ path('app_guide_edit', {'id': guide.id}) }}">edit</a>

{% endblock %}
