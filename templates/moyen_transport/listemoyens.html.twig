     {% endblock %}
{% block body %}
<div class="container" >
<h1>Transportation List</h1>



<div id="searchsection">
<form method="POST" action="/searchmoyen">
<label> Search by Model / Type </label>
<input type="text" name="idmodele" placeholder="Model"/>
<select name="typeMoyen" id="typeselect" >
    <option value="" selected disabled>Choose a type</option>
    <option value="Plane">Plane</option>
    <option value="Bus">Bus</option>
</select>
<button id="searchbtn" type="submit"> <img id="searchicon" src="{{ asset('images/SearchIcon.png') }}"/>  Search </button>
</form>
</div>
<a href={{ path('addMoyen') }}><button class="btn btn-success"> <img id="addimg" src="{{ asset('images/AddIcon.png') }}"/>    Add </button> </a>


<table class="table table-striped">
<thead>
<tr> <th> ID </th> <th> Category </th> <th> Type </th> <th> Model </th>  <th> Actions</th> </tr>
</thead>
<tbody>
{% if response is empty %}
<h2> No Result Found !!</h2>
{% endif %}

{% for t in response %}
<tr class="voyages-row">
<td>{{t.id}} </td><td>{{t.categorieMoyen}} </td> <td>{{t.typeMoyen}} </td> <td>{{t.idModele}} </td><td><a href={{ path('updateMoyen',  {'id' : t.id}) }}> <button id="updatebtn" class="btn btn-primary"><img id="updateimg" src="{{ asset('images/UpdateIcon.png') }}"/>Update</button></a> <br> <a href={{ path('removeMoyen',  {'id' : t.id}) }} ><button class="btn btn-danger deletebutton" data="{{ {'Category': t.categorieMoyen, 'Type': t.typeMoyen, 'Model': t.idModele} | json_encode}} "> <img id="delimg" src="{{ asset('images/DeleteIcon.png') }}"/>Delete </button></a></td>
</tr>
{% endfor %}
</tbody>
</table>

</div>




{# javascript for delete button  #}
 <script>
        document.querySelectorAll('.deletebutton').forEach(button => {
            button.addEventListener('click', function(event) {
                if (!confirm('Do you really want to delete the following transportation: ' + button.getAttribute('data') )) {
                    event.preventDefault();
                }
            });
        });
    </script>
{% endblock %}