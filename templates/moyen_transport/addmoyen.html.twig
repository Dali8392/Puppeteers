     {% endblock %}





{% block body %}
<div id="main-container" style="margin-bottom : 45px; max-height : 134vh ">
<div id="form-container" >
<div class="text-center">
<h3 style="font-weight : bold ;  margin-bottom : 35px"> Add Transportation </h3>
</div>

<div class="row justify-content-center">

{{ form_start(f, {'attr': {'novalidate': 'novalidate'}}) }}
 <div class="form-group">
{{ form_label(f.typeMoyen, "Type", {'label_attr': {'class': 'form-label'}}) }}
 {{ form_widget(f.typeMoyen, {'attr': {'class': 'form-control'}}) }}
 {% if form_errors(f.typeMoyen) is not empty %}
 <div class="alert alert-danger">
 {{ form_errors(f.typeMoyen) }}
 </div>
 {% endif %}
 </div>

 <div class="form-group">
{{ form_label(f.categorieMoyen, "Category", {'label_attr': {'class': 'form-label'}}) }}
 {{ form_widget(f.categorieMoyen, {'attr': {'class': 'form-control'}}) }}
 {% if form_errors(f.categorieMoyen) is not empty %}
 <div class="alert alert-danger">
 {{ form_errors(f.categorieMoyen) }}
 </div>
 {% endif %}
 </div>

  <div class="form-group">
{{ form_label(f.idModele, "Model", {'label_attr': {'class': 'form-label'}}) }}
 {{ form_widget(f.idModele, {'attr': {'class': 'form-control'}}) }}
 {% if form_errors(f.idModele) is not empty %}
 <div class="alert alert-danger">
 {{ form_errors(f.idModele) }}
 </div>
 {% endif %}
 </div>


  <div class="text-center">
                     {{ form_widget(f.submit, {'attr': {'class': 'btn btn-primary' , 'style': 'width : 400px ; margin-top: 30px;margin-bottom: 20px; height : 52px ; font-size : 21px;font-weight : bold; '}}) }}
                    </div>
<div class="text-center" style="margin-bottom: 30px;">
<a id="cancel-link" href={{ path('moyensList') }} > Cancel </a>                   </div>
{{ form_end(f) }}
</div>
</div>
</div>


 {% endblock %}