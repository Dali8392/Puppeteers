{# templates/comment/create.html.twig #}



{% block title %}Create a Comment{% endblock %}

{% block body %}
    <h1>Create a Comment</h1>
    {{ form_start(form) }}
        {{ form_row(form.date) }}
        {{ form_row(form.contenu) }}
        {{ form_row(form.sender) }}
        {{ form_row(form.event) }}
        {{ form_row(form.submit) }}
    {{ form_end(form) }}

{% endblock %}
