{% extends 'base.html.twig' %}

{% block title %}{% endblock %}

{% block body %}
    

<body>

	<div class="home">
	</div>

	<!-- Single Listing -->
	<div class="container">
		<div class="row">
			<div class="col-lg-12">
				<div class="single_listing">
					
					<!-- Hotel Info -->
					<div class="hotel_info">

						<!-- Title -->
						<div class="hotel_title_container d-flex flex-lg-row flex-column">
							<div class="hotel_title_content">
								<h1 class="hotel_title">Grand Hotel Eurostar</h1>
								<div class="rating_r rating_r_4 hotel_rating">
									<i></i>
									<i></i>
									<i></i>
									<i></i>
									<i></i>
								</div>
								<div class="hotel_location">345 677 Gran Via Street, no 34, Madrid, Spain</div>
							</div>
							<div class="hotel_title_button ml-lg-auto text-lg-right">
								<div class="button book_button trans_200"><a href="#">book<span></span><span></span><span></span></a></div>
								<div class="hotel_map_link_container">
									<div class="hotel_map_link">See Location on Map</div>
								</div>
							</div>
						</div>

						<!-- Listing Image -->
						<div class="hotel_image">
							<img src="/images/listing_hotel.jpg" alt="">
						</div>

						<!-- Reviews -->
						<div class="reviews">
							<div class="reviews_title">Reviews</div>
							<div class="reviews_container">
								{% for comment in comments %}
									{% if comment.getEvent().getId() == id %}
										<div class="review">
											<div class="row">
												<div class="col-lg-1">
													<div class="review_image">
														<img src="/images/review_1.jpg" alt="Profile Image">
													</div>
												</div>
												<div class="col-lg-9">
													<div class="review_content">
														<div class="review_title_container">
															<div class="review_title">{{ comment.getContenu() }}</div>
														</div>
														<div class="review_name">{{ comment.getSender() }}</div>
														<div class="review_date">{{ comment.getDate() }}</div>
													</div>
												</div>
												<div class="col-lg-2">
													<!-- Update button -->
													<a href="{{ path('comment_edit', {'id': comment.getId()}) }}" class="btn btn-primary">Update</a>
													<!-- Delete form -->
													<form action="{{ path('comment_delete', {'id': comment.getId()}) }}" method="post">
														<input type="hidden" name="_method" value="DELETE">
														<button type="submit" class="btn btn-danger">Delete</button>
													</form>
												</div>
											</div>
										</div>
									{% endif %}
								{% endfor %}
							</div>
						</div>

						<!-- Form for editing or creating a comment -->
						<div class="comment_form">
							{{ form_start(form, {'action': path('comment_edit', {'id': id}), 'method': 'POST', 'attr': {'novalidate': 'novalidate'}}) }}
								{{ form_row(form.sender) }}
								{{ form_row(form.contenu) }}
								{{ form_row(form.submit) }}
							{{ form_end(form) }}
						</div>

						<!-- Location on Map -->
						<div class="location_on_map">
							<div class="location_on_map_title">Location on Map</div>
							<!-- Google Map -->
							<div class="travelix_map">
								<div id="google_map" class="google_map">
									<div class="map_container">
										<div id="map"></div>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>

</body>

{% endblock %}
