{% extends 'base.html.twig' %}

{% block title %}Custom Event{% endblock %}

{% block body %}

        <!-- Google Web Fonts -->
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Jost:wght@500;600&family=Roboto&display=swap" rel="stylesheet"> 

        <!-- Icon Font Stylesheet -->
        <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.15.4/css/all.css"/>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">

        <!-- Libraries Stylesheet -->
        <link href="/lib/owlcarousel/assets/owl.carousel.min.css" rel="stylesheet">
        <link href="/lib/lightbox/css/lightbox.min.css" rel="stylesheet">


        <!-- Customized Bootstrap Stylesheet -->
        <link href="/css/bootstrap.min.css" rel="stylesheet">

        <!-- Template Stylesheet -->
        <link href="/css/style.css" rel="stylesheet">

    <body>

        <!-- Spinner Start -->
        <div id="spinner" class="show bg-white position-fixed translate-middle w-100 vh-100 top-50 start-50 d-flex align-items-center justify-content-center">
            <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;" role="status">
                <span class="sr-only">Loading...</span>
            </div>
        </div>
        <!-- Spinner End -->


        

        <!-- Tour Booking Start -->
{{ form_start(form, {'id': 'eventForm', 'method': 'POST', 'attr': {'novalidate': 'novalidate'}}) }}

<div class="container-fluid booking py-5">
    <div class="container py-5">
        <div class="row g-5 align-items-center">
            <div class="col-lg-6">
                <h5 class="section-booking-title pe-3">Booking</h5>
                <h1 class="text-white mb-4">Online Booking</h1>
                <p class="text-white mb-4">Lorem ipsum dolor sit amet consectetur adipisicing elit. Aspernatur maxime ullam esse fuga blanditiis accusantium pariatur quis sapiente, veniam doloribus praesentium? Repudiandae iste voluptatem fugiat doloribus quasi quo iure officia.</p>
                <p class="text-white mb-4">Lorem ipsum dolor sit amet consectetur adipisicing elit. Aspernatur maxime ullam esse fuga blanditiis accusantium pariatur quis sapiente, veniam doloribus praesentium? Repudiandae iste voluptatem fugiat doloribus quasi quo iure officia.</p>
                <a href="#" class="btn btn-light text-primary rounded-pill py-3 px-5 mt-2">Read More</a>
            </div>
            <div class="col-lg-6">
                <h1 class="text-white mb-3">Create your Custom Trip</h1>
                <p class="text-white mb-4">Plan your custom Trip now and avail of special discounts!</p>
    <div class="container">
                    <table class="table">
                        <tbody>
                            <tr>
                                <td>
                                    <div class="form-floating">
                                        {{ form_row(form.name, {'label': 'Event Name', 'attr': {'class': 'form-control bg-white border-0 ', 'placeholder': 'Event Name', 'value': events.name() }}) }}
                                    </div>
                                </td>
                                <td>
                                    <div class="form-floating">
                        {{ form_row(form.type, {'label': 'Event Type', 'attr': {'class': 'form-control bg-white border-0', 'placeholder': 'Event Type', 'value': events.Type() }}) }}
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <div class="form-floating date" id="date3" data-target-input="nearest">
                                        {{ form_row(form.date_debut, {'label': 'Start Date', 'attr': {'class': 'form-control bg-white border-0', 'placeholder': 'Start Date', 'data-toggle': 'datetimepicker' }}) }}
                                    </div>
                                </td>
                                <td>
                                    <div class="form-floating date" id="date3" data-target-input="nearest">
                                        {{ form_row(form.date_fin, {'label': 'End Date', 'attr': {'class': 'form-control bg-white border-0', 'placeholder': 'End Date', 'data-toggle': 'datetimepicker' }}) }}
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    
                                </td>
                                <td>
                            <a href="{{ path('emap', {'id': events.id}) }}" class="btn btn-primary">Choose Location</a>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <div class="form-floating">
                                        {{ form_row(form.budget_allocated, {'label': 'Event Budget', 'attr': {'class': 'form-control bg-white border-0', 'placeholder': 'Event Budget'}}) }}
                                    </div>
                                </td>
                                <td>
                                    <div class="form-floating">
                                        {{ form_row(form.max_participants, {'label': 'Max Event Participants', 'attr': {'class': 'form-control bg-white border-0', 'placeholder': 'Max Event Participants'}}) }}
                                    </div>
                                </td>
                            </tr>
                           
                        </tbody>
                    </table>
                </div>
                <div class="col-12">
                    <button class="btn btn-primary text-white w-100 py-3" type="submit">Edit Event</button>
                </div>
            </div>
        </div>
    </div>
</div>
{{ form_end(form) }}
<!-- Tour Booking End -->


        

        <!-- Back to Top -->
        <a href="#" class="btn btn-primary btn-primary-outline-0 btn-md-square back-to-top"><i class="fa fa-arrow-up"></i></a>   

        
        <!-- JavaScript Libraries -->
        <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.4/jquery.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
        <script src="/lib/easing/easing.min.js"></script>
        <script src="/lib/waypoints/waypoints.min.js"></script>
        <script src="/lib/owlcarousel/owl.carousel.min.js"></script>
        <script src="/lib/lightbox/js/lightbox.min.js"></script>
        

        <!-- Template Javascript -->
        <script src="/js/main.js"></script>
    </body>

</html>
{% endblock %}