{% extends 'base.html.twig' %}

{% block title %}Add Note
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<style>
		.main {
			position: relative;
			display: flex;
			flex-direction: column;
			background-color: #240046;
			max-height: 500px;
			overflow: hidden;
			border-radius: 12px;
			box-shadow: 7px 7px 10px 3px #24004628;
			margin: 300px auto 40px;
			width: 500px;
		}

		.form {
			display: flex;
			flex-direction: column;
			gap: 14px;
			padding: 24px;
		}

		.input {
			width: 100%;
			height: 40px;
			background: #e0dede;
			padding: 10px;
			border: none;
			outline: none;
			border-radius: 4px;
		}

		.form button {
			width: 85%;
			height: 40px;
			margin: 12px auto 10%;
			color: #fff;
			background: #573b8a;
			font-size: 1rem;
			font-weight: bold;
			border: none;
			border-radius: 4px;
			cursor: pointer;
			transition: background-color 0.2s ease-in;
		}

		.form button:hover {
			background-color: #6d44b8;
		}

		label {
			color: #fff;
			font-size: 2rem;
			font-weight: bold;
			cursor: pointer;
			transition: color 0.5s ease-in-out;
		}

		#chk {
			position: absolute;
			opacity: 0;
			height: 0;
			width: 0;
		}

		label[for="chk"] {
			padding: 10px 20px;
			background-color: #573b8a;
			border-radius: 4px;
			transition: background-color 0.2s ease-in;
		}

		label[for="chk"]:hover {
			background-color: #6d44b8;
		}
	</style>
{% endblock %}

{% block body %}
	<div class="main">
		<input type="checkbox" id="chk" aria-hidden="true">
		{{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}

		<div class="note form">
			<label for="chk" aria-hidden="true" style="text-align: center;">My Rating</label>
			{{ form_row(form.note, {'attr': {'class': 'input', 'placeholder': 'Note', 'required': 'required'}}) }}
			{{ form_row(form.commentaire, {'attr': {'class': 'input', 'placeholder': 'Commentaire', 'required': 'required'}}) }}
			<button type="submit">Add</button>
		</div>
	</div>
{% endblock %}
