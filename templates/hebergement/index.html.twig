{% extends 'base.html.twig' %}

{% block body %}
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8">
			<meta name="viewport" content="width=device-width, initial-scale=1.0">
			<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">


			<style>


				body {
					text-align: center;
					font-size: 18px;
					color: #000;
				}

				h1 {
					font-size: 30px;
					font-weight: bold;
					color: #4A235A;
				}

				.custom-table {
					margin-top: 200px;
					border-bottom: 10px solid #ccc;
					padding-bottom: 20px;
				}

				.card {
					width: 350px;
					height: 450px;
					background: #FBEEFD;
					border-radius: 20px;
					box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
					margin: 10px;
					display: inline-block;
					vertical-align: top;
					font-family: 'Roboto', sans-serif;
					text-align: center;
				}

				.hebergement-title {
					margin-top: 20px;
				}

				.hebergement-adresse {
					line-height: 4;
				}
				.hebergement-price {
					font-weight: bold;
					color: #641E16;
					line-height: 4;
				}
				.hebergement-buttons {
					position: absolute;
					bottom: -3px;
					left: 50%;
					transform: translateX(-50%);
				}


				.button {
					text-decoration: none;
					text-align: center;
					-webkit-transform: translate(-50%, 125%);
					-ms-transform: translate(-50%, 125%);
					transform: translate(-50%, 125%);
					width: 150px;
					border-radius: 1rem;
					border: none;
					background-color: #A569BD;
					color: #fff;
					font-size: 1rem;
					padding: 0.5rem 1rem;
					position: absolute;
					left: 50%;
					bottom: 0;
					opacity: 0;
					-webkit-transition: 0.3s ease-out;
					transition: 0.3s ease-out;
					cursor: pointer;
					font-family: Arial, Helvetica, sans-serif;
				}
				.card:hover {
					border-color: #6c00f8;
					-webkit-box-shadow: 10px 5px 18px 0 rgba(255, 255, 255, 0.877);
					box-shadow: 10px 5px 18px 0 rgba(255, 255, 255, 0.877);
				}

				.card:hover .button {
					-webkit-transform: translate(-50%, 50%);
					-ms-transform: translate(-50%, 50%);
					transform: translate(-50%, 50%);
					opacity: 1;
				}
				.contact_form_container {
					text-align: left;
					margin-bottom: 20px;

				}

				.form {
					position: left;
					width: 100%;
					padding: 20px;
					border-radius: 10px;
					box-shadow: 0 50px 50px -50px rgba(27, 26, 26, 0.315);
				}

				.form .contact_title {
					color: royalblue;
					font-size: 30px;
					font-weight: 600;
					letter-spacing: -1px;
					line-height: 30px;
					margin-bottom: 20px;
				}

				.form input,
				.form textarea {
					outline: 0;
					border: 1px solid rgb(219, 213, 213);
					padding: 8px 14px;
					border-radius: 8px;
					width: 100%;
					margin-bottom: 10px;
				}

				.form textarea {
					height: 100px;
					resize: none;
				}

				.form button {
					padding: 8px;
					outline: 0;
					border: 0;
					border-radius: 8px;
					font-size: 16px;
					font-weight: 500;
					background-color: royalblue;
					color: #fff;
					cursor: pointer;
					align-self: flex-end;
				}
				.title {
					margin-bottom: 35px;
					text-align: center;
					color: #4A235A;
					font-family: "Lucida Console", "Courier New", monospace;
					font-size: 30px;

				}
				.custom-select {
					border: none; /* Remove the border */
					appearance: none; /* Remove default arrow icon */
					-webkit-appearance: none; /* Remove default arrow icon for WebKit browsers */
				}
				.body {
					width: 900px;
					height: 400px;
					align-items: center;
					justify-content: center;
					position: center;
					border-radius: 3px;
					border: 1px solid #396afc;
					background: linear-gradient(to right, #8CC1F0 , #BA93D3);
					box-shadow: rgba(0, 0, 0, 0.24) 0 3px 8px;
					top: 50%;
					left: 25%;
					right: 50%;
					margin: 30px;
				}

				.container form .descr {
					font-size: 20px;
					font-weight: 500;
					color: #2C2C2C;
					margin-bottom: 25px;
					margin-top: 25px;
					text-align: center;
				}

				.form {
					display: flex;
					flex-direction: column;
				}

				.input,
				textarea {
					margin: 1em 0;
					width: 600px;
					position: relative;
				}

				.input input,
				textarea {
					font-size: 100%;
					padding: 0.7em;
					outline: none;
					color: #2C2C2C;
					border: none;
					border-bottom: 2px solid #e8e8e8;
					background: transparent;
					border-radius: none;
					width: 100%;
					resize: none;
				}

				.input label {
					font-size: 100%;
					position: absolute;
					left: 0;
					color: #2C2C2C;
					padding: 0.7em;
					margin-left: 0.1em;
					pointer-events: none;
					transition: all 0.5s ease;
					text-transform: uppercase;
				}

				.input:is(input:focus, input:valid)~label {
					transform: translateY(-50%) scale(0.9);
					margin: 0;
					padding: 0.4em;
					background: transparent;
				}

				.input textarea:focus ~ label,
				.input textarea:valid ~ label {
					transform: translateY(-50%) scale(0.9);
					margin: 0;
					padding: 0.4em;
					background: transparent;
				}

				.inputGroup:is(input:focus, input:valid) {
					border-color: rgb(37, 37, 211);
				}

				.form button {
					color: #2C2C2C;
					font-size: 15px;
					align-self: flex-start;
					padding: 0.6em;
					border: none;
					cursor: pointer;
					margin-bottom: 50px;
					background: transparent;
					transition: all 0.3s ease-in-out;
					position: relative;
					overflow: hidden;
				}

				.form button:before {
					content: "";
					position: absolute;
					bottom: 100%;
					left: 0;
					width: 100%;
					height: 100%;
					background-color: #2C2C2C;
					opacity: 0;
					transition: opacity 0.3s ease-in-out;
				}

				.form button:hover:before {
					opacity: 0.2;
				}

				.form button:hover {
					transform: translateY(-3px);
					box-shadow: 0 5px 15px rgba(0, 0, 0, 0.3);
				}
				.container {
					--color: #a5a;
					--size: 30px;
					display: flex;
					justify-content: center;
					align-items: center;
					position: absolute;
					left: 0; /* Align to the left */
					cursor: pointer;
					font-size: var(--size);
					user-select: none;
					fill: var(--color);
				}

				.container .star-regular {
					position: absolute;
					animation: keyframes-star 0.5s;
				}

				.container .star-solid {
					position: absolute;
					animation: keyframes-star 0.5s;
					display: none;
				}

				/* ------ On check event ------ */
				.container input:checked ~ .star-regular {
					display: none;
				}

				.container input:checked ~ .star-solid {
					display: block;
				}

				/* ------ Hide the default checkbox ------ */
				.container input {
					position: absolute;
					opacity: 0;
					cursor: pointer;
					height: 0;
					width: 0;
				}

				/* ------ Animations ------ */
				@keyframes keyframes-star {
					0% {
						transform: rotate(0deg) scale(0);
						opacity: 0;
					}

					50% {
						transform: rotate(10deg) scale(1.3);
					}
				}
			</style>
		</head>
		<body>

			<div class="contact_background" style="background-image:url(images/background.jpg)"></div>
			<div class="custom-table">

				<h1 style="text-align: center;">List of Accommodations</h1>
				<div style="text-align: center;">
					<select class="custom-select" title="Type" onchange="location = this.value;">
						<option value="{{ path('liste') }}">All</option>
						{% for type in types %}
							<option value="{{ path('liste', {'type': type.id}) }}" {% if selectedType == type.id %} selected {% endif %}>{{ type.type }}</option>
						{% endfor %}
					</select>
				</div>
				{% for hebergement in hebergements %}
					<div class="card">
						<label class="container">
							<input type="checkbox" checked="checked">
							<svg class="star-regular" xmlns="http://www.w3.org/2000/svg" height="1em" viewbox="0 0 576 512">
								<path d="M287.9 0c9.2 0 17.6 5.2 21.6 13.5l68.6 141.3 153.2 22.6c9 1.3 16.5 7.6 19.3 16.3s.5 18.1-5.9 24.5L433.6 328.4l26.2 155.6c1.5 9-2.2 18.1-9.6 23.5s-17.3 6-25.3 1.7l-137-73.2L151 509.1c-8.1 4.3-17.9 3.7-25.3-1.7s-11.2-14.5-9.7-23.5l26.2-155.6L31.1 218.2c-6.5-6.4-8.7-15.9-5.9-24.5s10.3-14.9 19.3-16.3l153.2-22.6L266.3 13.5C270.4 5.2 278.7 0 287.9 0zm0 79L235.4 187.2c-3.5 7.1-10.2 12.1-18.1 13.3L99 217.9 184.9 303c5.5 5.5 8.1 13.3 6.8 21L171.4 443.7l105.2-56.2c7.1-3.8 15.6-3.8 22.6 0l105.2 56.2L384.2 324.1c-1.3-7.7 1.2-15.5 6.8-21l85.9-85.1L358.6 200.5c-7.8-1.2-14.6-6.1-18.1-13.3L287.9 79z"></path>
							</svg>
							<svg class="star-solid" xmlns="http://www.w3.org/2000/svg" height="1em" viewbox="0 0 576 512">
								<path d="M316.9 18C311.6 7 300.4 0 288.1 0s-23.4 7-28.8 18L195 150.3 51.4 171.5c-12 1.8-22 10.2-25.7 21.7s-.7 24.2 7.9 32.7L137.8 329 113.2 474.7c-2 12 3 24.2 12.9 31.3s23 8 33.8 2.3l128.3-68.5 128.3 68.5c10.8 5.7 23.9 4.9 33.8-2.3s14.9-19.3 12.9-31.3L438.5 329 542.7 225.9c8.6-8.5 11.7-21.2 7.9-32.7s-13.7-19.9-25.7-21.7L381.2 150.3 316.9 18z"></path>
							</svg>
						</label>
						<h3 class="hebergement-title">{{ hebergement.name }}</h3>
						<img src="{{ hebergement.Image }}.jpg" width="250" height="200">
						<div class="hebergement-adresse">{{ hebergement.adresse }}</div>
						<div class="hebergement-price">${{ hebergement.tarif }}
							per night</div>
						<div class="hebergement-buttons">
							<a href="{{ path('hebergement_details', {'id': hebergement.id}) }}" class="button">See Details</a>

						</div>
					</div>
				{% endfor %}
			</div>
			<div class="body">
				<form class="form">
					<div class="descr">Accommodation offer – Contact us now!</div>
					<div class="input">
						<input required="" autocomplete="off" name="email" type="text">
						<label for="E-mail">E-mail</label>
					</div>
					<div class="input">
						<textarea required="" cols="30" rows="1" id="message"></textarea>
						<label for="offer">Your offer</label>
					</div>
					<button>Send message →</button>
				</form>
			</div>
		</body>
	</html>
{% endblock %}
