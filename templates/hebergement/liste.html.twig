{# hebergement/details.html.twig #}

{% extends 'base.html.twig' %}

{% block title %}Détails de l'hébergement{% endblock %}

{% block body %}
<div class="container">
    <h1>{% block heading %}Détails de l'hébergement{% endblock %}</h1>

    {% for hebergement in hebergements %}
    <div class="hebergement">
        <h2>ID: {{ hebergement.id }}</h2>
        <p>Adresse: {{ hebergement.adresse }}</p>
        <p>Tarif: {{ hebergement.tarif }}</p>
        <p>Description: {{ hebergement.description }}</p>
        <p>Etat: {{ hebergement.etat }}</p>
        <p>Date Disponibilité: {{ hebergement.dateDisponibilite|date('d/m/Y') }}</p>
        <p>Capacité: {{ hebergement.capacite }}</p>
    </div>
    {% endfor %}
    
    <a href="{{ path('hebergement_liste') }}">Retour à la liste des hébergements</a>
</div>
{% endblock %}
