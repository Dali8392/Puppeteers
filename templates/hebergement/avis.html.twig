{% extends 'base.html.twig' %}

{% block title %}Avis{% endblock %}

{% block body %}
<br>
<br>
<br>
<br>
<br>
<br>
<br>
<div class="container">
    <div class="grix xs2 sm3 gutter-0 card">
        <h1 style="margin-bottom: 35px; text-align: center; color:#5A0883">Rating</h1>
        {% if allAvis is not empty %}
            <ul class="rating-list">
                {% for avi in allAvis %}
                    <li class="rating-item">
					<p>
                            <strong>E-mail:</strong>
                            <span class="text">{{ avi.email }}</span>
                        </p>
                        <p>
                            <strong>Rate:</strong>
                            <span class="text">{{ avi.note }}</span>
                        </p>
                        <p>
                            <strong>Comment:</strong>
                            <span class="text">{{ avi.commentaire }}</span>
                        </p>
                    </li>
                {% endfor %}
            </ul>
        {% else %}
            <p>No Rating</p>
        {% endif %}
    </div>
    <div class="col-xs2 col-sm3">
        {{ form_start(form) }}
		{{ form_row(form.email) }}
        {{ form_row(form.note) }}
        {{ form_row(form.commentaire) }}
        <button type="submit">Enregistrer</button>
       
    </div>
</div>
{% endblock %}
